{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": { "resourceClass": "m-medium" },
      "env": { "EXPO_NO_TELEMETRY": "1" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "EXPO_NO_TELEMETRY": "1" }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
